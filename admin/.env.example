# EduTrack API (Express + MongoDB)
VITE_API_URL=http://localhost:5001/api
# EduTrack student portal. Its login page (Administrator tab) is the only
# sign-in screen: signed-out visitors and "Sign out" go to
# <this URL>/login?role=admin. Change it if the student portal runs on
# another port (e.g. http://localhost:5175 when 5173 is taken).
VITE_STUDENT_PORTAL_URL=http://localhost:5173
